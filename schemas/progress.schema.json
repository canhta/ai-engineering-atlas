{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Engineering Atlas learner progress",
  "type": "object",
  "required": ["version", "updated_at", "competencies"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 2
    },
    "updated_at": {
      "type": "string"
    },
    "competencies": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["current_state", "target_state", "evidence", "state_history", "next_action"],
        "properties": {
          "current_state": {
            "enum": ["unassessed", "gap", "learning", "demonstrated", "transferred", "retained", "applied"]
          },
          "target_state": {
            "enum": ["demonstrated", "transferred", "retained", "applied"]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "kind", "supports_state", "recorded_at", "independence", "review_method"],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "minLength": 1
                },
                "supports_state": {
                  "enum": ["gap", "learning", "demonstrated", "transferred", "retained", "applied"]
                },
                "recorded_at": {
                  "type": "string"
                },
                "uri": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                },
                "independence": {
                  "enum": ["independent", "minimal-hints", "guided", "reference-open", "unknown"]
                },
                "review_method": {
                  "enum": ["self", "peer", "automated", "automated-and-self", "ai-assisted", "human-and-ai"]
                },
                "review_note": {
                  "type": "string"
                },
                "retrieval_result": {
                  "description": "For kind \"retrieval\" only: the diagnostic result the learner reported, mapped to an FSRS rating by site/src/lib/review.ts.",
                  "enum": ["meets", "partial", "notYet"]
                }
              },
              "additionalProperties": true
            }
          },
          "state_history": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["state", "recorded_at", "reason", "evidence_refs"],
              "properties": {
                "state": {
                  "enum": ["unassessed", "gap", "learning", "demonstrated", "transferred", "retained", "applied"]
                },
                "recorded_at": {
                  "type": "string"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_refs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                }
              },
              "additionalProperties": true
            }
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          },
          "review_on": {
            "type": "string",
            "description": "Calendar date the next delayed-retrieval check is due, computed by site/src/lib/review.ts (ts-fsrs). Same field as before FSRS; only how it is computed changed."
          },
          "review": {
            "description": "FSRS card state (site/src/lib/review.ts), under one key so a pre-FSRS file (review_on only, no card) stays valid; it is read as a fresh card and seeded on the next evidence. Field names and grain follow ts-fsrs's Card.",
            "type": "object",
            "properties": {
              "due": {
                "type": "string",
                "description": "ISO instant the card is next due (full FSRS precision; review_on is its calendar date)."
              },
              "stability": { "type": "number" },
              "difficulty": { "type": "number" },
              "elapsed_days": { "type": "number" },
              "scheduled_days": { "type": "number" },
              "learning_steps": { "type": "integer" },
              "reps": { "type": "integer" },
              "lapses": { "type": "integer" },
              "state": {
                "enum": ["new", "learning", "review", "relearning"]
              },
              "last_review": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
