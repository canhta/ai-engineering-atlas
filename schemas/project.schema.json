{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/canhta/ai-engineering-atlas/blob/main/schemas/project.schema.json",
  "title": "AI Engineering Atlas reference project",
  "description": "A reference project and its titled milestones (rfcs/0022-titled-project-milestones.md). The project's competencies and evidence are the union of its milestones' integrates and evidence.",
  "type": "object",
  "required": ["id", "title", "spines", "purpose", "milestones"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^project\\.[a-z0-9.-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "spines": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["foundation", "ai-system", "production"] }
    },
    "purpose": { "type": "string", "minLength": 1 },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "description": "In README order. A missing ask, an empty integrates, or an empty evidence list is an open owner question; scripts/validate_repo.py reports it as a warning.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "integrates", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1, "description": "Equals a ## heading in the project README." },
          "ask": { "type": "string", "minLength": 1, "maxLength": 300 },
          "integrates": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string" },
            "description": "Catalog competency IDs."
          },
          "evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
          },
          "package": {
            "type": "string",
            "pattern": "^[a-z0-9-]+/$",
            "description": "Evidence package directory inside the project, containing README.md."
          }
        }
      }
    }
  }
}
