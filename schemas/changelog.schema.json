{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Engineering Atlas curriculum change log",
  "description": "curriculum/changelog.yaml: dated curriculum changes, oldest first. Contract and validation rules: rfcs/0021-dated-curriculum-changes.md.",
  "type": "object",
  "required": ["version", "releases", "changes"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "date"],
        "additionalProperties": false,
        "properties": {
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "date": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "kind"],
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "kind": { "enum": ["promoted", "demoted", "added", "removed", "lab-added", "lab-removed"] },
          "competencies": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9.-]+$" }
          },
          "labs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
          "rfc": { "type": "string", "pattern": "^\\d{4}$" },
          "pre_rfc": { "const": true },
          "release": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "note": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "enum": ["lab-added", "lab-removed"] } } },
            "then": {
              "required": ["labs"],
              "not": { "anyOf": [{ "required": ["competencies"] }, { "required": ["pre_rfc"] }] }
            },
            "else": {
              "required": ["competencies"],
              "not": { "required": ["labs"] },
              "oneOf": [
                { "required": ["rfc"], "not": { "required": ["pre_rfc"] } },
                { "required": ["pre_rfc", "note"], "not": { "required": ["rfc"] } }
              ]
            }
          }
        ]
      }
    }
  }
}
