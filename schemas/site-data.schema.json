{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Engineering Atlas web site data",
  "description": "Generated by scripts/build_site_data.py. Route bodies are validated separately against competency.schema.json.",
  "type": "object",
  "required": [
    "version",
    "levels",
    "domains",
    "competencies",
    "edges",
    "routes",
    "resources",
    "labs",
    "projects",
    "paths"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "catalog_version": {
      "type": "integer"
    },
    "last_reviewed": {
      "type": "string"
    },
    "levels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "path", "target"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "target": {"type": "string"}
        }
      }
    },
    "competencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "domain", "status"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "minLength": 1},
          "status": {"enum": ["coverage", "ready"]},
          "route": {"type": "string", "minLength": 1}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "additionalProperties": false,
        "properties": {
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1}
        }
      }
    },
    "routes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "title", "domain", "status", "path"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["seeded", "ready"]},
          "path": {"type": "string", "minLength": 1}
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["title", "url"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "type": {"type": "string"},
          "author": {"type": "string"},
          "url": {"type": "string", "minLength": 1},
          "roles": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "labs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "path", "files", "competencies"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "files": {"type": "array", "items": {"type": "string"}},
          "competencies": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "purpose", "path", "spines", "milestones", "competencies"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "purpose": {"type": "string"},
          "path": {"type": "string", "minLength": 1},
          "spines": {"type": "array", "items": {"type": "string"}},
          "milestones": {"type": "array", "items": {"type": "string"}},
          "competencies": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "file"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "file": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
