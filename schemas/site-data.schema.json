{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Engineering Atlas content model",
  "description": "Content model v2 for the web atlas, generated by scripts/build_site_data.py from curriculum/presentation.yaml. Contract: rfcs/0000-content-model.md.",
  "type": "object",
  "required": ["version", "site", "locales", "vocabularies", "collections", "items", "relations", "resources"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 2
    },
    "site": {
      "type": "object",
      "required": ["title", "tagline", "repository"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "$ref": "#/$defs/l10n"
        },
        "tagline": {
          "$ref": "#/$defs/l10n"
        },
        "repository": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "links": {
          "type": "array",
          "description": "Owner contact and profile links, rendered as icons in the frame.",
          "items": {
            "type": "object",
            "required": ["kind", "url"],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": ["github", "email", "whatsapp", "zalo", "x", "linkedin"]
              },
              "url": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      },
      "contains": {
        "const": "en"
      }
    },
    "vocabularies": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": ["label", "order"],
          "additionalProperties": false,
          "properties": {
            "label": {
              "$ref": "#/$defs/l10n"
            },
            "order": {
              "type": "integer"
            },
            "description": {
              "$ref": "#/$defs/l10n"
            }
          }
        }
      }
    },
    "collections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/collection"
      }
    },
    "items": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/item"
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "from", "to"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "$ref": "#/$defs/ref"
          },
          "to": {
            "$ref": "#/$defs/ref"
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["title", "url"],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string"
          },
          "author": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "l10n": {
      "type": "object",
      "required": ["en"],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string"
        },
        "vi": {
          "type": "string"
        }
      }
    },
    "ref": {
      "description": "A bare competency id, or <collection-prefix>:<id> for other collections.",
      "type": "string",
      "minLength": 1
    },
    "resourceRef": {
      "description": "A key in resources, or an absolute URL.",
      "type": "string",
      "minLength": 1
    },
    "scalar": {
      "type": ["string", "number", "boolean"]
    },
    "collection": {
      "type": "object",
      "required": ["id", "label", "fields"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "$ref": "#/$defs/l10n"
        },
        "ref_prefix": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["label"],
            "additionalProperties": false,
            "properties": {
              "label": {
                "$ref": "#/$defs/l10n"
              },
              "vocabulary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "group_by": {
          "type": "string"
        },
        "facets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "list_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "page_when": {
          "type": "object",
          "required": ["field", "in"],
          "additionalProperties": false,
          "properties": {
            "field": {
              "type": "string"
            },
            "in": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "progress": {
          "type": "object",
          "required": ["tracks"],
          "additionalProperties": false,
          "properties": {
            "tracks": {
              "type": "boolean"
            },
            "target_field": {
              "type": "string"
            }
          }
        }
      }
    },
    "item": {
      "type": "object",
      "required": ["id", "title", "fields"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "$ref": "#/$defs/l10n"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/scalar"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/scalar"
                }
              }
            ]
          }
        },
        "page": {
          "type": "object",
          "required": ["source_path", "blocks"],
          "additionalProperties": false,
          "properties": {
            "source_path": {
              "type": "string",
              "minLength": 1
            },
            "blocks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/block"
              }
            }
          }
        }
      }
    },
    "block": {
      "description": "Block types: text, list, prerequisites, diagnostic, sources, practice, runner, form, data. Every block has type, id, and title.",
      "type": "object",
      "required": ["type", "id", "title"],
      "properties": {
        "type": {
          "enum": ["text", "list", "prerequisites", "diagnostic", "sources", "practice", "runner", "form", "data"]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "$ref": "#/$defs/l10n"
        },
        "step": {
          "const": true,
          "description": "The block is a learner step (the site may number it or track it)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/textBlock"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "list"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/listBlock"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "prerequisites"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/prerequisitesBlock"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "diagnostic"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/diagnosticBlock"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "sources"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/sourcesBlock"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "practice"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/practiceBlock"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "runner"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/runnerBlock"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "form"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/formBlock"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "data"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/dataBlock"
          }
        }
      ]
    },
    "textBlock": {
      "required": ["body"],
      "properties": {
        "type": true,
        "id": true,
        "title": true,
        "step": true,
        "body": {
          "$ref": "#/$defs/l10n"
        },
        "format": {
          "const": "markdown",
          "description": "The body is Markdown; omitted for plain paragraphs."
        }
      },
      "additionalProperties": false
    },
    "listBlock": {
      "required": ["items", "ordered"],
      "properties": {
        "type": true,
        "id": true,
        "title": true,
        "step": true,
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/l10n"
          }
        },
        "ordered": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "prerequisitesBlock": {
      "required": ["items"],
      "properties": {
        "type": true,
        "id": true,
        "title": true,
        "step": true,
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ref"],
            "additionalProperties": false,
            "properties": {
              "ref": {
                "$ref": "#/$defs/ref"
              },
              "bridge": {
                "type": "object",
                "required": ["resource"],
                "additionalProperties": false,
                "properties": {
                  "diagnostic": {
                    "$ref": "#/$defs/l10n"
                  },
                  "resource": {
                    "$ref": "#/$defs/resourceRef"
                  },
                  "locator": {
                    "$ref": "#/$defs/l10n"
                  },
                  "purpose": {
                    "$ref": "#/$defs/l10n"
                  }
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "diagnosticBlock": {
      "required": ["tasks", "pass_condition"],
      "properties": {
        "type": true,
        "id": true,
        "title": true,
        "step": true,
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/l10n"
          }
        },
        "pass_condition": {
          "$ref": "#/$defs/l10n"
        }
      },
      "additionalProperties": false
    },
    "sourcesBlock": {
      "required": ["rows"],
      "properties": {
        "type": true,
        "id": true,
        "title": true,
        "step": true,
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["resource", "locator", "purpose"],
            "additionalProperties": false,
            "properties": {
              "resource": {
                "$ref": "#/$defs/resourceRef"
              },
              "locator": {
                "$ref": "#/$defs/l10n"
              },
              "purpose": {
                "$ref": "#/$defs/l10n"
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "practiceBlock": {
      "required": ["groups"],
      "properties": {
        "type": true,
        "id": true,
        "title": true,
        "step": true,
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "items"],
            "additionalProperties": false,
            "properties": {
              "label": {
                "$ref": "#/$defs/l10n"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["text"],
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "$ref": "#/$defs/l10n"
                    },
                    "ref": {
                      "$ref": "#/$defs/ref"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "resource": {
                      "$ref": "#/$defs/resourceRef"
                    },
                    "locator": {
                      "$ref": "#/$defs/l10n"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "runnerBlock": {
      "description": "A lab the site runs in the browser: the files it ships and which one the learner edits.",
      "required": ["runtime", "editable", "run", "reference", "files"],
      "properties": {
        "type": true,
        "id": true,
        "title": true,
        "step": true,
        "runtime": {
          "enum": ["pyodide"]
        },
        "editable": {
          "type": "string",
          "minLength": 1,
          "description": "File the learner edits; a key of files."
        },
        "run": {
          "type": "string",
          "minLength": 1,
          "description": "File run as __main__; a key of files."
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "description": "Reference solution, shown only on request; a key of files."
        },
        "files": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          },
          "description": "File name to text."
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Runtime packages to load before running."
        }
      },
      "additionalProperties": false
    },
    "formBlock": {
      "description": "A rubric or decision form the learner fills (a decision lab's browser: {runtime: form} contract).",
      "required": ["fields"],
      "properties": {
        "type": true,
        "id": true,
        "title": true,
        "step": true,
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label", "type"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "$ref": "#/$defs/l10n" },
              "type": { "enum": ["text", "longtext", "choice", "table"] },
              "help": { "$ref": "#/$defs/l10n" },
              "options": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/l10n" },
                "description": "Choice values; required when type is choice."
              },
              "columns": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["id", "label"],
                  "additionalProperties": false,
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "label": { "$ref": "#/$defs/l10n" }
                  }
                },
                "description": "Table columns; required when type is table."
              }
            },
            "allOf": [
              { "if": { "properties": { "type": { "const": "choice" } } }, "then": { "required": ["options"] } },
              { "if": { "properties": { "type": { "const": "table" } } }, "then": { "required": ["columns"] } }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "dataBlock": {
      "required": ["value"],
      "properties": {
        "type": true,
        "id": true,
        "title": true,
        "step": true,
        "value": true
      },
      "additionalProperties": false
    }
  }
}
