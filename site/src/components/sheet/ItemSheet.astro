---
// Item sheet (DESIGN.md → Route sheet), rendered generically from an item's blocks, set like a
// book chapter: section label, title, details line, lead, prerequisite line, then contents rail |
// reading column | margin column with the region locator and the field log. Items of collections that do not track
// progress get the same sheet without the margin column; a runner or form makes it a workbench.
import Base from "../../layouts/Base.astro";
import Icon from "../Icon.astro";
import Block from "../blocks/Block.astro";
import RegionLocator from "../plate/RegionLocator.astro";
import DetailsLine from "../react/DetailsLine";
import FieldLog from "../react/FieldLog";
import PrereqLine, { type PrereqEntry } from "../react/PrereqLine";
import StepRail, { type RailEntry } from "../react/StepRail";
import { useTranslations, type Lang } from "../../i18n";
import {
  bridgeAnchor,
  detailsOf,
  groupOf,
  itemUrl,
  langAttr,
  pageSegment,
  repoUrl,
  resolveRef,
  stateLabels,
  targetOf,
  text,
  trackedCollection,
  trackedItemsPointingAt,
  type Collection,
  type Item,
} from "../../lib/atlas";
import { TARGET_STATES, type TargetState } from "../../lib/progress";
import { refOf } from "../../lib/refs";
import { nextGraph, nextLinks } from "../../lib/summaries";
import { mapUrl } from "../../lib/urls";

interface Props {
  collection: Collection;
  item: Item;
  lang: Lang;
}

const { collection: c, item, lang } = Astro.props;
const t = useTranslations(lang);
const page = item.page!;
const ref = refOf(c, item);
const title = text(item.title, lang);

// The first plain text block is the subtitle; every other block renders in content order.
const subtitleBlock = page.blocks.find((b) => b.type === "text" && !b.format);
const subtitle = subtitleBlock?.type === "text" ? text(subtitleBlock.body, lang) : undefined;
const blocks = page.blocks.filter((b) => b !== subtitleBlock);
const untranslated = lang !== "en" && (title.lang !== lang || (subtitle && subtitle.lang !== lang));

// Section label above the title: the item's group (its region in the Atlas), or its collection.
const group = groupOf(c, item, lang);
const section = group
  ? { label: group.label, href: `${mapUrl(lang)}?group=${encodeURIComponent(group.value)}` }
  : { label: text(c.label, lang), href: c.page_when ? mapUrl(lang) : `/${lang}/${pageSegment(c)}/` };
const details = detailsOf(c, item, lang);

// Learner progress: only for collections that track it.
const declaredTarget = targetOf(c, item);
const target: TargetState | undefined = c.progress?.tracks
  ? (TARGET_STATES as readonly string[]).includes(declaredTarget ?? "")
    ? (declaredTarget as TargetState)
    : "demonstrated"
  : undefined;

const prereqBlock = page.blocks.find((b) => b.type === "prerequisites");
const prereqs: PrereqEntry[] =
  prereqBlock?.type === "prerequisites"
    ? prereqBlock.items.map((p) => {
        const found = resolveRef(p.ref);
        return {
          ref: p.ref,
          title: found ? text(found.item.title, lang) : { value: p.ref, lang: "en" },
          url: itemUrl(lang, p.ref),
          bridgeAnchor: p.bridge ? bridgeAnchor(p.ref) : undefined,
        };
      })
    : [];

// Next-step line in the field log: the whole graph (ranking needs it) and links for this item's prerequisites.
const graph = target ? nextGraph() : [];
const adviceLinks = nextLinks(
  lang,
  (graph.find((g) => g.id === ref)?.needs ?? []).map((n) => n.id),
);

// Tracked items that point at this one (the competencies a lab practises), with their state glyph.
const practisedBy: PrereqEntry[] = trackedItemsPointingAt(ref).map((i) => ({
  ref: refOf(trackedCollection, i),
  title: text(i.title, lang),
  url: itemUrl(lang, refOf(trackedCollection, i)),
}));

// A page with a runner or a form is a workbench (DESIGN.md → Labs): the other blocks read in one
// column, the bench sits beside them; there is no rail.
const bench = blocks.find((b) => b.type === "runner" || b.type === "form");
const reading = blocks.filter((b) => b !== bench);

let stepNumber = 0;
const railEntries: RailEntry[] = blocks.map((b) => {
  const step = b.step ? ++stepNumber : undefined;
  const track: RailEntry["track"] =
    b.type === "diagnostic" && target
      ? { answers: b.tasks.length }
      : b.type === "sources"
        ? { opened: b.rows.map((r) => `${ref}#${b.id}#${r.resource}`) }
        : b.type === "list" && b.step && target
          ? { evidence: true }
          : undefined;
  return { id: b.id, title: text(b.title, lang), step, track };
});
---

<Base lang={lang} title={title.value} description={subtitle?.value} section="atlas">
  <article class:list={["sheet", { tracked: Boolean(target), workbench: Boolean(bench) }]}>
    <header class="sheet-head">
      <p class="section-label">
        <a href={section.href} lang={langAttr(section.label, lang)}>
          {section.label.value}
        </a>
      </p>
      <h1 class="page-title" lang={langAttr(title, lang)}>
        {title.value}
      </h1>
      <DetailsLine lang={lang} details={details} />
      {subtitle && (
        <p class="lead" lang={langAttr(subtitle, lang)}>
          {subtitle.value}
        </p>
      )}
      {untranslated && (
        <p class="untranslated small" role="note">
          {t("translation.missing")}
        </p>
      )}
      {prereqs.length > 0 && <PrereqLine client:idle lang={lang} entries={prereqs} />}
      {practisedBy.length > 0 && <PrereqLine client:idle lang={lang} entries={practisedBy} lead={t("lab.practises")} />}
      <div class="sheet-actions">
        <a class="button-quiet" href={repoUrl(page.source_path)} rel="noopener noreferrer">
          {t("sheet.contract")}
          <Icon name="external" />
          <span class="visually-hidden">({t("link.external")})</span>
        </a>
        <button class="button-quiet" type="button" data-copy-link data-copied={t("sheet.copied")}>
          {t("sheet.copy")}
          <Icon name="copyLink" />
        </button>
        <span class="live-message small" role="status" data-copy-result></span>
      </div>
      {bench && (
        <a class="button-quiet bench-jump" href={`#${bench.id}`}>
          <Icon name="code" />
          {bench.type === "form" ? t("form.toForm") : t("lab.toCode")}
        </a>
      )}
    </header>

    {bench ? (
      <div class:list={["bench-grid", { wide: bench.type === "form" }]}>
        <div class="sheet-content">
          {reading.map((b) => (
            <section id={b.id} class:list={["block", `block-${b.type}`]} aria-labelledby={`${b.id}-title`}>
              <h2 id={`${b.id}-title`} lang={langAttr(text(b.title, lang), lang)}>
                {text(b.title, lang).value}
              </h2>
              <Block
                block={b}
                lang={lang}
                itemRef={ref}
                target={target}
                after={[]}
                headingId={`${b.id}-title`}
                sourcePath={page.source_path}
              />
            </section>
          ))}
        </div>
        <section id={bench.id} class="bench" aria-labelledby={`${bench.id}-title`}>
          <h2 id={`${bench.id}-title`} class="bench-title" lang={langAttr(text(bench.title, lang), lang)}>
            {text(bench.title, lang).value}
          </h2>
          <Block
            block={bench}
            lang={lang}
            itemRef={ref}
            target={target}
            after={[]}
            headingId={`${bench.id}-title`}
            sourcePath={page.source_path}
          />
        </section>
      </div>
    ) : (
      <div class="sheet-grid">
        <StepRail client:load lang={lang} itemRef={ref} entries={railEntries} />
        <div class="sheet-content">
          {blocks.map((b, i) => (
            <section
              id={b.id}
              class:list={["block", `block-${b.type}`, { step: b.step }]}
              aria-labelledby={`${b.id}-title`}
            >
              <h2 id={`${b.id}-title`} lang={langAttr(text(b.title, lang), lang)}>
                {railEntries[i].step && (
                  <span class="block-step tabular" aria-hidden="true">
                    {railEntries[i].step}
                  </span>
                )}
                {text(b.title, lang).value}
              </h2>
              <Block
                block={b}
                lang={lang}
                itemRef={ref}
                target={target}
                after={blocks.slice(i + 1)}
                headingId={`${b.id}-title`}
                sourcePath={page.source_path}
              />
            </section>
          ))}
        </div>
        {target && (
          <div class="sheet-margin">
            <RegionLocator lang={lang} collection={c} item={item} itemRef={ref} />
            <FieldLog
              client:load
              lang={lang}
              itemRef={ref}
              target={target}
              stateLabels={stateLabels(lang)}
              graph={graph}
              links={adviceLinks}
            />
          </div>
        )}
      </div>
    )}
  </article>
</Base>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-link]")) {
    button.addEventListener("click", async () => {
      const live = button.parentElement?.querySelector<HTMLElement>("[data-copy-result]");
      try {
        await navigator.clipboard.writeText(location.href.split("#")[0]);
        if (live) live.textContent = button.dataset.copied ?? "";
      } catch {
        if (live) live.textContent = location.href.split("#")[0];
      }
    });
  }
</script>

<style>
  /* Header, set like a chapter opening: section label, title, details line, lead. */
  .sheet-head {
    max-width: var(--reading-width);
    margin-bottom: var(--space-12);
  }

  .sheet-head .section-label {
    margin-bottom: var(--space-2);
  }

  .sheet-head .page-title {
    margin-bottom: var(--space-3);
  }

  .sheet-head :global(.details-line) {
    margin-bottom: var(--space-6);
  }

  .sheet-head .lead {
    max-width: var(--measure);
    margin: 0 0 var(--space-5);
    color: var(--ink);
  }

  .untranslated {
    display: inline-block;
    margin: 0 0 var(--space-5);
    padding: var(--space-1) var(--space-3);
    border: var(--border-width) dashed var(--line-strong);
    border-radius: var(--radius-mark);
    color: var(--ink-muted);
  }

  .sheet-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    margin-left: calc(-1 * var(--space-3));
  }

  /* Contents rail | reading column | margin column. The header lines up with the reading column. */
  .sheet-grid {
    display: grid;
    grid-template-columns: var(--rail-width) minmax(0, var(--reading-width)) var(--log-width);
    grid-template-areas: "rail content margin";
    justify-content: space-between;
    column-gap: var(--space-10);
    align-items: start;
  }

  .sheet:not(.tracked) .sheet-grid {
    grid-template-columns: var(--rail-width) minmax(0, var(--reading-width));
    grid-template-areas: "rail content";
    justify-content: start;
  }

  .sheet:not(.workbench) .sheet-head {
    margin-left: calc(var(--rail-width) + var(--space-10));
  }

  .sheet-content {
    grid-area: content;
    min-width: 0;
  }

  /* The margin column: sticky beside the reading column, behind a hairline; it never overlaps it. */
  .sheet-margin {
    grid-area: margin;
    position: sticky;
    top: calc(var(--bar-offset) + var(--space-6));
    max-height: calc(100dvh - var(--bar-offset) - var(--space-8));
    overflow: auto;
    overscroll-behavior: contain;
    padding: 0 var(--space-1) var(--space-4) var(--space-6);
    border-left: var(--border-width) solid var(--line);
  }

  .block {
    padding: var(--space-10) 0;
    border-top: var(--border-width) solid var(--line);
  }

  .block:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .block h2 {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  /* Step numbers read like section numbers in a book: a quiet numeral before the heading. */
  .block-step {
    flex: none;
    min-width: 1.25rem;
    font-family: var(--font-sans);
    font-size: var(--text-ui);
    font-weight: 600;
    color: var(--ink-muted);
  }

  /* Workbench pages (DESIGN.md → Labs): brief | bench, the bench sticky under the nav. */
  .bench-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-10);
    align-items: start;
  }

  /* A decision form carries a comparison table: give it more width than a code bench. */
  .bench-grid.wide {
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
  }

  .bench-grid .sheet-content {
    grid-area: auto;
  }

  .bench {
    position: sticky;
    top: calc(var(--bar-offset) + var(--space-4));
    max-height: calc(100vh - var(--bar-offset) - var(--space-8));
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .bench-title {
    margin: 0 0 var(--space-3);
    font-size: var(--text-h3);
  }

  .bench-jump {
    display: none;
  }

  @media (width < 1024px) {
    .sheet-grid,
    .sheet:not(.tracked) .sheet-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "rail" "margin" "content";
      row-gap: var(--space-6);
    }

    .sheet:not(.tracked) .sheet-grid {
      grid-template-areas: "rail" "content";
    }

    .sheet:not(.workbench) .sheet-head {
      margin-left: 0;
    }

    .sheet-margin {
      position: static;
      max-height: none;
      overflow: visible;
      padding: 0;
      border-left: 0;
    }

    .bench-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }

    .bench {
      position: static;
      max-height: none;
      overflow: visible;
      scroll-margin-top: var(--bar-offset);
    }

    .bench-jump {
      display: inline-flex;
      margin-top: var(--space-4);
    }
  }

  @media (width < 768px) {
    /* The field log leaves the column for the bottom bar (FieldLog); the margin column stays empty. */
    .sheet-grid {
      grid-template-areas: "rail" "content" "margin";
    }

    .sheet.tracked {
      padding-bottom: var(--space-16);
    }

    .sheet-head {
      margin-bottom: var(--space-8);
    }
  }
</style>
