---
// Item sheet (DESIGN.md → Route sheet), rendered generically from an item's blocks: header,
// prerequisite line, then rail | reading column | field log. Items of collections that do not
// track progress get the same sheet without the field log.
import Base from "../../layouts/Base.astro";
import Breadcrumb, { type Crumb } from "../Breadcrumb.astro";
import Icon from "../Icon.astro";
import Block from "../blocks/Block.astro";
import FieldLog from "../react/FieldLog";
import PrereqLine, { type PrereqEntry } from "../react/PrereqLine";
import StepRail, { type RailEntry } from "../react/StepRail";
import { useTranslations, type Lang } from "../../i18n";
import {
  bridgeAnchor,
  groupOf,
  headerChips,
  itemUrl,
  langAttr,
  repoUrl,
  resolveRef,
  stateLabels,
  targetOf,
  text,
  trackedCollection,
  trackedItemsPointingAt,
  type Collection,
  type Item,
} from "../../lib/atlas";
import { TARGET_STATES, type TargetState } from "../../lib/progress";
import { refOf } from "../../lib/refs";
import { nextGraph, nextLinks } from "../../lib/summaries";
import { mapUrl } from "../../lib/urls";

interface Props {
  collection: Collection;
  item: Item;
  lang: Lang;
}

const { collection: c, item, lang } = Astro.props;
const t = useTranslations(lang);
const page = item.page!;
const ref = refOf(c, item);
const title = text(item.title, lang);

// The first plain text block is the subtitle; every other block renders in content order.
const subtitleBlock = page.blocks.find((b) => b.type === "text" && !b.format);
const subtitle = subtitleBlock?.type === "text" ? text(subtitleBlock.body, lang) : undefined;
const blocks = page.blocks.filter((b) => b !== subtitleBlock);
const untranslated = lang !== "en" && (title.lang !== lang || (subtitle && subtitle.lang !== lang));

const group = groupOf(c, item, lang);
const crumbs: Crumb[] = [
  { label: t("nav.atlas"), href: mapUrl(lang) },
  group
    ? {
        label: group.label.value,
        href: `${mapUrl(lang)}?group=${encodeURIComponent(group.value)}`,
        lang: langAttr(group.label, lang),
      }
    : { label: text(c.label, lang).value, lang: langAttr(text(c.label, lang), lang) },
  { label: title.value, lang: langAttr(title, lang) },
];
// Short vocabulary codes (such as levels) show beside their label in the chip.
const chips = headerChips(c, item, lang);

// Learner progress: only for collections that track it.
const declaredTarget = targetOf(c, item);
const target: TargetState | undefined = c.progress?.tracks
  ? (TARGET_STATES as readonly string[]).includes(declaredTarget ?? "")
    ? (declaredTarget as TargetState)
    : "demonstrated"
  : undefined;

const prereqBlock = page.blocks.find((b) => b.type === "prerequisites");
const prereqs: PrereqEntry[] =
  prereqBlock?.type === "prerequisites"
    ? prereqBlock.items.map((p) => {
        const found = resolveRef(p.ref);
        return {
          ref: p.ref,
          title: found ? text(found.item.title, lang) : { value: p.ref, lang: "en" },
          url: itemUrl(lang, p.ref),
          bridgeAnchor: p.bridge ? bridgeAnchor(p.ref) : undefined,
        };
      })
    : [];

// Next-step line in the field log: the whole graph (ranking needs it) and links for this item's prerequisites.
const graph = target ? nextGraph() : [];
const adviceLinks = nextLinks(
  lang,
  (graph.find((g) => g.id === ref)?.needs ?? []).map((n) => n.id),
);

// Tracked items that point at this one (the competencies a lab practises), with their state glyph.
const practisedBy: PrereqEntry[] = trackedItemsPointingAt(ref).map((i) => ({
  ref: refOf(trackedCollection, i),
  title: text(i.title, lang),
  url: itemUrl(lang, refOf(trackedCollection, i)),
}));

// A page with a runner or a form is a workbench (DESIGN.md → Labs): the other blocks read in one
// column, the bench sits beside them; there is no rail.
const bench = blocks.find((b) => b.type === "runner" || b.type === "form");
const reading = blocks.filter((b) => b !== bench);

let stepNumber = 0;
const railEntries: RailEntry[] = blocks.map((b) => {
  const step = b.step ? ++stepNumber : undefined;
  const track: RailEntry["track"] =
    b.type === "diagnostic" && target
      ? { answers: b.tasks.length }
      : b.type === "sources"
        ? { opened: b.rows.map((r) => `${ref}#${b.id}#${r.resource}`) }
        : b.type === "list" && b.step && target
          ? { evidence: true }
          : undefined;
  return { id: b.id, title: text(b.title, lang), step, track };
});
---

<Base lang={lang} title={title.value} description={subtitle?.value} section="atlas">
  <article class:list={["sheet", { tracked: Boolean(target) }]}>
    <header class="sheet-head">
      <Breadcrumb lang={lang} crumbs={crumbs} />
      <h1 class="display" lang={langAttr(title, lang)}>
        {title.value}
      </h1>
      {subtitle && (
        <p class="lead" lang={langAttr(subtitle, lang)}>
          {subtitle.value}
        </p>
      )}
      {untranslated && (
        <p class="untranslated small" role="note">
          {t("translation.missing")}
        </p>
      )}
      <div class="sheet-meta">
        {chips.length > 0 && (
          <ul class="chips" aria-label={t("sheet.facts")}>
            {chips.map((chip) => (
              <li class="chip" lang={langAttr(chip.label, lang)} title={text(c.fields[chip.field]?.label, lang).value}>
                {chip.value.length <= 3 && chip.value !== chip.label.value && <code>{chip.value}</code>}
                {chip.label.value}
              </li>
            ))}
          </ul>
        )}
        <div class="sheet-actions">
          <a class="button-quiet" href={repoUrl(page.source_path)} rel="noopener noreferrer">
            {t("sheet.contract")}
            <Icon name="external" />
            <span class="visually-hidden">({t("link.external")})</span>
          </a>
          <button class="button-quiet" type="button" data-copy-link data-copied={t("sheet.copied")}>
            {t("sheet.copy")}
            <Icon name="copyLink" />
          </button>
          <span class="live-message small" role="status" data-copy-result></span>
        </div>
      </div>
      {prereqs.length > 0 && <PrereqLine client:idle lang={lang} entries={prereqs} />}
      {practisedBy.length > 0 && <PrereqLine client:idle lang={lang} entries={practisedBy} lead={t("lab.practises")} />}
      {bench && (
        <a class="button-quiet bench-jump" href={`#${bench.id}`}>
          <Icon name="code" />
          {bench.type === "form" ? t("form.toForm") : t("lab.toCode")}
        </a>
      )}
    </header>

    {bench ? (
      <div class="bench-grid">
        <div class="sheet-content">
          {reading.map((b) => (
            <section id={b.id} class:list={["block", `block-${b.type}`]} aria-labelledby={`${b.id}-title`}>
              <h2 id={`${b.id}-title`} lang={langAttr(text(b.title, lang), lang)}>
                {text(b.title, lang).value}
              </h2>
              <Block
                block={b}
                lang={lang}
                itemRef={ref}
                target={target}
                after={[]}
                headingId={`${b.id}-title`}
                sourcePath={page.source_path}
              />
            </section>
          ))}
        </div>
        <section id={bench.id} class="bench" aria-labelledby={`${bench.id}-title`}>
          <h2 id={`${bench.id}-title`} class="bench-title" lang={langAttr(text(bench.title, lang), lang)}>
            {text(bench.title, lang).value}
          </h2>
          <Block
            block={bench}
            lang={lang}
            itemRef={ref}
            target={target}
            after={[]}
            headingId={`${bench.id}-title`}
            sourcePath={page.source_path}
          />
        </section>
      </div>
    ) : (
      <div class="sheet-grid">
        <StepRail client:load lang={lang} itemRef={ref} entries={railEntries} />
        <div class="sheet-content">
          {blocks.map((b, i) => (
            <section
              id={b.id}
              class:list={["block", `block-${b.type}`, { step: b.step }]}
              aria-labelledby={`${b.id}-title`}
            >
              <h2 id={`${b.id}-title`} lang={langAttr(text(b.title, lang), lang)}>
                {railEntries[i].step && (
                  <span class="block-step tabular" aria-hidden="true">
                    {railEntries[i].step}
                  </span>
                )}
                {text(b.title, lang).value}
              </h2>
              <Block
                block={b}
                lang={lang}
                itemRef={ref}
                target={target}
                after={blocks.slice(i + 1)}
                headingId={`${b.id}-title`}
                sourcePath={page.source_path}
              />
            </section>
          ))}
        </div>
        {target && (
          <FieldLog
            client:load
            lang={lang}
            itemRef={ref}
            target={target}
            stateLabels={stateLabels(lang)}
            graph={graph}
            links={adviceLinks}
          />
        )}
      </div>
    )}
  </article>
</Base>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-link]")) {
    button.addEventListener("click", async () => {
      const live = button.parentElement?.querySelector<HTMLElement>("[data-copy-result]");
      try {
        await navigator.clipboard.writeText(location.href.split("#")[0]);
        if (live) live.textContent = button.dataset.copied ?? "";
      } catch {
        if (live) live.textContent = location.href.split("#")[0];
      }
    });
  }
</script>

<style>
  .sheet-head {
    max-width: 60rem;
    margin-bottom: var(--space-12);
  }

  .sheet-head .display {
    margin-bottom: var(--space-5);
  }

  .sheet-head .lead {
    margin-bottom: var(--space-6);
  }

  .untranslated {
    display: inline-block;
    margin: 0 0 var(--space-5);
    padding: var(--space-1) var(--space-3);
    border: var(--border-width) dashed var(--line-strong);
    border-radius: var(--radius-pill);
    color: var(--ink-muted);
  }

  .sheet-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    margin-bottom: var(--space-5);
  }

  .sheet-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .sheet-grid {
    display: grid;
    grid-template-columns: var(--rail-width) minmax(0, 1fr) var(--log-width);
    grid-template-areas: "rail content log";
    gap: var(--space-8);
    align-items: start;
  }

  .sheet:not(.tracked) .sheet-grid {
    grid-template-columns: var(--rail-width) minmax(0, 1fr);
    grid-template-areas: "rail content";
  }

  .sheet-content {
    grid-area: content;
    min-width: 0;
  }

  .block {
    padding: var(--space-10) 0;
    border-top: var(--border-width) solid var(--line);
  }

  .block:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .block h2 {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  /* Workbench pages (DESIGN.md → Labs): brief | bench, the bench sticky under the nav. */
  .bench-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-10);
    align-items: start;
  }

  .bench-grid .sheet-content {
    grid-area: auto;
  }

  .bench {
    position: sticky;
    top: calc(var(--nav-offset) + var(--nav-height) + var(--space-4));
    max-height: calc(100vh - var(--nav-offset) - var(--nav-height) - var(--space-8));
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .bench-title {
    margin: 0 0 var(--space-3);
    font-size: var(--text-h3);
  }

  .bench-jump {
    display: none;
  }

  .block-step {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    border: 1.5px solid var(--route);
    border-radius: 50%;
    font-size: var(--text-small);
    font-weight: 600;
    font-variation-settings: "wdth" 100;
    color: var(--route);
    transform: translateY(-0.15em);
  }

  @media (width < 1024px) {
    .sheet-grid,
    .sheet:not(.tracked) .sheet-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "rail" "log" "content";
      gap: var(--space-6);
    }

    .sheet:not(.tracked) .sheet-grid {
      grid-template-areas: "rail" "content";
    }

    .bench-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }

    .bench {
      position: static;
      max-height: none;
      overflow: visible;
      scroll-margin-top: calc(var(--nav-offset) + var(--nav-height));
    }

    .bench-jump {
      display: inline-flex;
      margin-top: var(--space-4);
    }
  }

  @media (width < 768px) {
    .sheet-grid {
      grid-template-areas: "rail" "content";
    }

    .sheet.tracked {
      padding-bottom: var(--space-16);
    }

    .sheet-head {
      margin-bottom: var(--space-8);
    }

    .sheet-meta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
