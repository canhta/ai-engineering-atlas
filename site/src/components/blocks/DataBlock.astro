---
// Generic fallback for unmapped content and unknown block types: nested lists of any JSON.
// Objects shaped like L10n render as localised text.
import type { Lang } from "../../i18n";
import { langAttr, text, type L10n } from "../../lib/atlas";

interface Props {
  value: unknown;
  lang: Lang;
}

const { value, lang } = Astro.props;
const isL10n = (v: unknown): v is L10n =>
  typeof v === "object" && v !== null && !Array.isArray(v) && typeof (v as L10n).en === "string" &&
  Object.keys(v).every((k) => k === "en" || k === "vi");
const localized = isL10n(value) ? text(value, lang) : undefined;
const Self = Astro.self;
---

{
  localized ? (
    <span lang={langAttr(localized, lang)}>{localized.value}</span>
  ) : Array.isArray(value) ? (
    <ul class="data-list">
      {value.map((v) => (
        <li>
          <Self value={v} lang={lang} />
        </li>
      ))}
    </ul>
  ) : typeof value === "object" && value !== null ? (
    <dl class="data-map">
      {Object.entries(value).map(([k, v]) => (
        <div>
          <dt>
            <code>{k}</code>
          </dt>
          <dd>
            <Self value={v} lang={lang} />
          </dd>
        </div>
      ))}
    </dl>
  ) : (
    <span lang="en">{String(value ?? "")}</span>
  )
}

<style>
  .data-list {
    margin: 0;
    padding-left: var(--space-5);
  }

  .data-map {
    display: grid;
    gap: var(--space-2);
    margin: 0;
  }

  .data-map div {
    display: grid;
    grid-template-columns: minmax(6rem, max-content) 1fr;
    gap: var(--space-3);
  }

  .data-map dd {
    margin: 0;
  }
</style>
