---
// Practice groups; each item links to its referenced item page, its repository path, or its
// resource, the exact locator first as in the bibliography.
import ResourceLink from "./ResourceLink.astro";
import { useTranslations, type Lang } from "../../i18n";
import { itemUrl, langAttr, repoUrl, resolveRef, resolveResource, text, type PracticeBlock } from "../../lib/atlas";

interface Props {
  block: PracticeBlock;
  lang: Lang;
}

const { block, lang } = Astro.props;
const t = useTranslations(lang);
const groups = block.groups.map((g) => ({
  label: text(g.label, lang),
  items: g.items.map((i) => {
    const target = i.ref ? resolveRef(i.ref) : undefined;
    return {
      body: text(i.text, lang),
      page: i.ref ? itemUrl(lang, i.ref) : undefined,
      refTitle: target ? text(target.item.title, lang) : undefined,
      refCollection: target ? text(target.collection.label, lang) : undefined,
      path: i.path,
      resource: i.resource ? resolveResource(i.resource) : undefined,
      locator: i.locator ? text(i.locator, lang) : undefined,
    };
  }),
}));
---

<div class="practice">
  {groups.map((g) => (
    <section class="practice-group">
      <h3 lang={langAttr(g.label, lang)}>{g.label.value}</h3>
      <ul>
        {g.items.map((i) => (
          <li>
            <p class="reading" lang={langAttr(i.body, lang)}>
              {i.body.value}
            </p>
            {(i.refTitle || i.path || i.resource) && (
              <div class="practice-links">
                {i.refTitle && i.page && (
                  <p class="practice-item">
                    <span class="muted" lang={langAttr(i.refCollection!, lang)}>
                      {i.refCollection!.value}
                    </span>{" "}
                    <a href={i.page} lang={langAttr(i.refTitle, lang)}>
                      {i.refTitle.value}
                    </a>
                  </p>
                )}
                {i.path && (
                  <a class="practice-path" href={repoUrl(i.path)}>
                    {i.refTitle && !i.page && (
                      <span class="practice-ref" lang={langAttr(i.refTitle, lang)}>
                        {i.refTitle.value}
                      </span>
                    )}
                    <code>{i.path}</code>
                    <span class="visually-hidden">({t("link.repository")})</span>
                  </a>
                )}
                {i.resource && (
                  <div class="practice-resource">
                    {i.locator && (
                      <p class="bib-locator" lang={langAttr(i.locator, lang)}>
                        {i.locator.value}
                      </p>
                    )}
                    <ResourceLink resource={i.resource} lang={lang} />
                  </div>
                )}
              </div>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .practice {
    display: grid;
    gap: var(--space-8);
  }

  .practice-group h3 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-ui);
    font-weight: 600;
    color: var(--ink-muted);
  }

  .practice-group ul {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .practice-group li {
    padding-left: var(--space-4);
    border-left: 2px solid var(--line);
  }

  .practice-group .reading {
    margin-bottom: var(--space-3);
  }

  .practice-links {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-3) var(--space-5);
  }

  .practice-path {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    overflow-wrap: anywhere;
  }

  .practice-ref {
    font-weight: 550;
  }

  .practice-item {
    margin: 0;
  }

  .practice-item a {
    font-weight: 550;
  }

  .practice-resource p {
    margin: 0 0 var(--space-1);
    max-width: var(--measure);
  }
</style>
