---
// Block registry (rfcs/0000-content-model.md → Blocks): one component per block type; an
// unknown type renders as `data`, so content never disappears silently.
import type { Lang } from "../../i18n";
import { refOf } from "../../lib/refs";
import {
  BLOCK_TYPES,
  resolveRef,
  resolveResource,
  stateLabels,
  targetOf,
  text,
  trackedCollection,
  trackedItemsPointingAt,
  type Block,
  type Localized,
} from "../../lib/atlas";
import type { FormField as ResolvedFormField } from "../../lib/lab-form";
import { TARGET_STATES, type TargetState } from "../../lib/progress";
import DecisionForm from "../react/DecisionForm";
import Diagnostic, { type NextLink } from "../react/Diagnostic";
import LabRunner, { type LabCompetency } from "../react/LabRunner";
import Bibliography from "../react/Bibliography";
import DataBlock from "./DataBlock.astro";
import ListBlock from "./ListBlock.astro";
import MilestonesBlock from "./MilestonesBlock.astro";
import PracticeBlock from "./PracticeBlock.astro";
import PrerequisitesBlock from "./PrerequisitesBlock.astro";
import SequenceBlock from "./SequenceBlock.astro";
import TextBlock from "./TextBlock.astro";

interface Props {
  block: Block;
  lang: Lang;
  itemRef: string;
  /** Learner target for tracked items; undefined when the collection does not track progress. */
  target?: TargetState;
  /** Following blocks, for the diagnostic's next-step links. */
  after: Block[];
  headingId: string;
  /** Repository path of the item, for relative links in Markdown text. */
  sourcePath: string;
}

const { block, lang, itemRef, target, after, headingId, sourcePath } = Astro.props;
const known = (BLOCK_TYPES as readonly string[]).includes(block.type);
const link = (b: Block | undefined): NextLink | undefined => (b ? { id: b.id, title: text(b.title, lang) } : undefined);
const sourceEntries =
  block.type === "sources"
    ? block.rows.map((row) => ({
        ...resolveResource(row.resource),
        key: `${itemRef}#${block.id}#${row.resource}`,
        locator: text(row.locator, lang),
        purpose: text(row.purpose, lang),
      }))
    : [];
const tasks: Localized[] = block.type === "diagnostic" ? block.tasks.map((prompt) => text(prompt, lang)) : [];
// A runner or form block records evidence against the tracked items that point at this item.
const competencies: LabCompetency[] =
  block.type === "runner" || block.type === "form"
    ? trackedItemsPointingAt(itemRef).map((item) => {
        const title = text(item.title, lang);
        const declared = targetOf(trackedCollection, item);
        return {
          ref: refOf(trackedCollection, item),
          title: title.value,
          lang: title.lang === lang ? undefined : title.lang,
          target: (TARGET_STATES as readonly string[]).includes(declared ?? "")
            ? (declared as TargetState)
            : "demonstrated",
        };
      })
    : [];
// A form block's fields carry curriculum text (L10n); resolve them to the page language server-side,
// same as sourceEntries/tasks above, so the island receives plain localized strings only.
const formFields: ResolvedFormField[] =
  block.type === "form"
    ? block.fields.map((f) => ({
        id: f.id,
        label: text(f.label, lang),
        type: f.type,
        help: f.help ? text(f.help, lang) : undefined,
        options: f.options?.map((o) => text(o, lang)),
        columns: f.columns?.map((c) => ({ id: c.id, label: text(c.label, lang) })),
      }))
    : [];
const formTitle = block.type === "form" ? text(resolveRef(itemRef)?.item.title, lang).value : "";
---

{block.type === "text" && <TextBlock block={block} lang={lang} sourcePath={sourcePath} />}
{block.type === "runner" && (
  <LabRunner
    client:load
    lang={lang}
    labRef={itemRef}
    files={block.files}
    editable={block.editable}
    run={block.run}
    reference={block.reference}
    packages={block.packages}
    competencies={competencies}
    stateLabels={stateLabels(lang)}
  />
)}
{block.type === "form" && (
  <DecisionForm
    client:load
    lang={lang}
    labRef={itemRef}
    title={formTitle}
    fields={formFields}
    competencies={competencies}
    stateLabels={stateLabels(lang)}
  />
)}
{block.type === "list" && <ListBlock block={block} lang={lang} />}
{block.type === "prerequisites" && <PrerequisitesBlock block={block} lang={lang} />}
{block.type === "practice" && <PracticeBlock block={block} lang={lang} />}
{block.type === "milestones" && <MilestonesBlock block={block} lang={lang} />}
{block.type === "sequence" && <SequenceBlock block={block} lang={lang} sourcePath={sourcePath} />}
{block.type === "sources" && <Bibliography client:load lang={lang} labelledBy={headingId} entries={sourceEntries} />}
{block.type === "diagnostic" &&
  (target ? (
    <Diagnostic
      client:load
      lang={lang}
      itemRef={itemRef}
      target={target}
      tasks={tasks}
      passCondition={text(block.pass_condition, lang)}
      next={{
        gap: link(after.find((b) => b.type === "sources")),
        meets: link(after.find((b) => b.type === "practice")),
      }}
    />
  ) : (
    <ListBlock block={{ ...block, type: "list", items: block.tasks, ordered: true }} lang={lang} />
  ))}
{(block.type === "data" || !known) && <DataBlock value={"value" in block ? block.value : block} lang={lang} />}
