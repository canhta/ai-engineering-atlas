---
// Prerequisites with their bridges (a diagnostic question and one exact source locator that
// patch a mapped prerequisite without its full route).
import type { Lang } from "../../i18n";
import { useTranslations } from "../../i18n";
import {
  bridgeAnchor,
  hasPage,
  itemUrl,
  langAttr,
  resolveRef,
  resolveResource,
  text,
  type PrerequisitesBlock,
} from "../../lib/atlas";
import { TileGlyph } from "../plate/TileGlyph";
import ResourceLink from "./ResourceLink.astro";

interface Props {
  block: PrerequisitesBlock;
  lang: Lang;
}

const { block, lang } = Astro.props;
const t = useTranslations(lang);
const entries = block.items.map((entry) => {
  const found = resolveRef(entry.ref);
  return {
    ...entry,
    title: found ? text(found.item.title, lang) : { value: entry.ref, lang: "en" as const },
    url: itemUrl(lang, entry.ref),
    ready: found ? hasPage(found.item) : false,
  };
});
---

{entries.length === 0 && <p class="muted">{t("prereq.none")}</p>}
<ul class="prereq-list">
  {entries.map((e) => {
    const b = e.bridge;
    const locator = b?.locator && text(b.locator, lang);
    const purpose = b?.purpose && text(b.purpose, lang);
    const question = b?.diagnostic && text(b.diagnostic, lang);
    return (
      <li id={b ? bridgeAnchor(e.ref) : undefined}>
        <p class="prereq-head">
          <TileGlyph fill={e.ready ? "ready" : "mapped"} />
          {e.url ? (
            <a href={e.url} lang={langAttr(e.title, lang)}>
              {e.title.value}
            </a>
          ) : (
            <span lang={langAttr(e.title, lang)}>{e.title.value}</span>
          )}
          <span class="muted small">{t(e.ready ? "prereq.ready" : "prereq.mapped")}</span>
        </p>
        {b && (
          <div class="bridge">
            <p class="bridge-label">{t("prereq.bridgeLabel")}</p>
            {question && (
              <p class="reading" lang={langAttr(question, lang)}>
                {question.value}
              </p>
            )}
            {locator && (
              <>
                <p class="bridge-label">{t("sources.col.locator")}</p>
                <p class="bib-locator" lang={langAttr(locator, lang)}>
                  {locator.value}
                </p>
              </>
            )}
            <p class="bridge-cite">
              <ResourceLink resource={resolveResource(b.resource)} lang={lang} />
            </p>
            {purpose && (
              <p class="bridge-purpose">
                <span class="bib-purpose-label">{t("sources.col.purpose")}</span>{" "}
                <span lang={langAttr(purpose, lang)}>{purpose.value}</span>
              </p>
            )}
          </div>
        )}
      </li>
    );
  })}
</ul>

<style>
  .prereq-list {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .prereq-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin: 0;
    font-weight: 550;
  }

  /* The bridge hangs under its prerequisite on a hairline, set like a bibliography entry:
     the question, then the exact locator, the source, and why (DESIGN.md → Route sheet). */
  .bridge {
    max-width: var(--measure);
    margin: var(--space-3) 0 0 calc(0.375rem - var(--border-width) / 2);
    padding: var(--space-1) 0 var(--space-1) var(--space-5);
    border-left: var(--border-width) solid var(--line-strong);
  }

  .bridge p {
    margin: 0;
  }

  .bridge-label {
    margin-bottom: var(--space-2);
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--ink-muted);
  }

  .bridge .reading {
    margin-bottom: var(--space-4);
  }

  .bridge-cite {
    margin-top: var(--space-2);
  }

  .bridge .bridge-purpose {
    margin-top: var(--space-2);
    font-family: var(--font-reading);
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }
</style>
