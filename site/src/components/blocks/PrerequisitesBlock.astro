---
// Prerequisites with their bridges (a diagnostic question and one exact source locator that
// patch a mapped prerequisite without its full route).
import type { Lang } from "../../i18n";
import { useTranslations } from "../../i18n";
import { bridgeAnchor, hasPage, itemUrl, langAttr, resolveRef, resolveResource, text, type PrerequisitesBlock } from "../../lib/atlas";
import { TileGlyph } from "../plate/TileGlyph";
import ResourceLink from "./ResourceLink.astro";

interface Props {
  block: PrerequisitesBlock;
  lang: Lang;
}

const { block, lang } = Astro.props;
const t = useTranslations(lang);
const entries = block.items.map((entry) => {
  const found = resolveRef(entry.ref);
  return {
    ...entry,
    title: found ? text(found.item.title, lang) : { value: entry.ref, lang: "en" as const },
    url: itemUrl(lang, entry.ref),
    ready: found ? hasPage(found.item) : false,
  };
});
---

{entries.length === 0 && <p class="muted">{t("prereq.none")}</p>}
<ul class="prereq-list">
  {
    entries.map((e) => {
      const b = e.bridge;
      const locator = b?.locator && text(b.locator, lang);
      const purpose = b?.purpose && text(b.purpose, lang);
      const question = b?.diagnostic && text(b.diagnostic, lang);
      return (
        <li id={b ? bridgeAnchor(e.ref) : undefined}>
          <p class="prereq-head">
            <TileGlyph fill={e.ready ? "ready" : "mapped"} />
            {e.url ? (
              <a href={e.url} lang={langAttr(e.title, lang)}>
                {e.title.value}
              </a>
            ) : (
              <span lang={langAttr(e.title, lang)}>{e.title.value}</span>
            )}
            <span class="muted small">{t(e.ready ? "prereq.ready" : "prereq.mapped")}</span>
          </p>
          {b && (
            <div class="bridge">
              <p class="bridge-label">{t("prereq.bridgeLabel")}</p>
              {question && (
                <p class="reading" lang={langAttr(question, lang)}>
                  {question.value}
                </p>
              )}
              <dl class="bridge-facts">
                <div>
                  <dt>{t("sources.col.resource")}</dt>
                  <dd>
                    <ResourceLink resource={resolveResource(b.resource)} lang={lang} />
                  </dd>
                </div>
                {locator && (
                  <div>
                    <dt>{t("sources.col.locator")}</dt>
                    <dd lang={langAttr(locator, lang)}>{locator.value}</dd>
                  </div>
                )}
                {purpose && (
                  <div>
                    <dt>{t("sources.col.purpose")}</dt>
                    <dd lang={langAttr(purpose, lang)}>{purpose.value}</dd>
                  </div>
                )}
              </dl>
            </div>
          )}
        </li>
      );
    })
  }
</ul>

<style>
  .prereq-list {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .prereq-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin: 0;
    font-weight: 550;
  }

  .bridge {
    max-width: var(--measure);
    margin-top: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border: var(--border-width) solid var(--line);
    border-radius: var(--radius-card);
    background: var(--sheet);
  }

  .bridge-label {
    margin: 0 0 var(--space-2);
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--ink-muted);
  }

  .bridge .reading {
    margin-bottom: var(--space-4);
  }

  .bridge-facts {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }

  .bridge-facts div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--space-3);
  }

  .bridge-facts dt {
    font-size: var(--text-small);
    color: var(--ink-muted);
  }

  .bridge-facts dd {
    margin: 0;
  }

  @media (width < 768px) {
    .bridge-facts div {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
