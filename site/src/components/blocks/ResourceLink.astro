---
// External resource set as a bibliography citation (DESIGN.md → Route sheet): the title linking
// out with the external mark, then its type and host as one muted line; says it leaves the site.
import Icon from "../Icon.astro";
import { useTranslations, type Lang } from "../../i18n";
import type { ResolvedResource } from "../../lib/atlas";

interface Props {
  resource: ResolvedResource;
  lang: Lang;
}

const { resource, lang } = Astro.props;
const t = useTranslations(lang);
const meta = [resource.kind, resource.host].filter(Boolean).join(", ");
---

<span class="resource">
  {resource.url ? (
    <a class="bib-title" href={resource.url} rel="noopener noreferrer" lang="en">
      {resource.title}
      <Icon name="external" />
      <span class="visually-hidden">({t("link.external")})</span>
    </a>
  ) : (
    <code class="bib-title">{resource.title}</code>
  )}
  {meta && (
    <span class="bib-meta" lang="en">
      {meta}
    </span>
  )}
</span>

<style>
  .resource {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    font-size: var(--text-ui);
  }
</style>
