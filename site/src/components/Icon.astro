---
// Renders a registry icon as static SVG (no client JavaScript). Decorative:
// every icon sits next to a text label (DESIGN.md → Icons).
import { Icon } from "./react/Icon";
import type { IconName } from "../lib/icons";

interface Props {
  name: IconName;
  size?: 16 | 20 | 24;
}

const { name, size = 16 } = Astro.props;
---

<Icon name={name} size={size} />
