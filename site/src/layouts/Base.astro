---
// Global frame (DESIGN.md → Global frame): floating pill nav, full-screen menu on mobile, footer.
import { Font } from "astro:assets";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/islands.css";
import Icon from "../components/Icon.astro";
import DueCount from "../components/react/DueCount";
import { languages, useTranslations, type Lang } from "../i18n";
import { site, text } from "../lib/atlas";
import { homeUrl, mapUrl, progressUrl, switchLang } from "../lib/urls";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Section of the site this page belongs to, for the active tab. */
  section?: "atlas" | "progress";
}

const { lang, title, description, section } = Astro.props;
const t = useTranslations(lang);
const siteTitle = text(site.title, lang).value;
const pageTitle = title ? `${title} | ${siteTitle}` : siteTitle;
const path = Astro.url.pathname;
const tabs = [
  { id: "atlas", href: mapUrl(lang), label: t("nav.atlas") },
  { id: "progress", href: progressUrl(lang), label: t("nav.progress") },
] as const;
const langs = Object.entries(languages) as [Lang, string][];
// Owner links are content (site.links), so adding one is a presentation.yaml change.
const linkLabels = {
  github: "GitHub",
  email: "Email",
  whatsapp: "WhatsApp",
  zalo: "Zalo",
  x: "X",
  linkedin: "LinkedIn",
} as const;
const ownerLinks = (site.links ?? []).map((l) => ({ ...l, label: linkLabels[l.kind] }));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? text(site.tagline, lang).value} />
    {langs.map(([l]) => (
      <link rel="alternate" hreflang={l} href={new URL(switchLang(path, l), Astro.site)} />
    ))}
    <Font cssVariable="--font-sans" preload={[{ subset: "latin" }]} />
    <Font cssVariable="--font-reading" />
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t("nav.skip")}
    </a>
    <header class="nav-wrap">
      <nav class="nav" aria-label={t("nav.label")}>
        <a class="wordmark" href={homeUrl(lang)}>
          {siteTitle}
        </a>
        <ul class="nav-tabs">
          {tabs.map((tab) => (
            <li>
              <a class="nav-tab" href={tab.href} aria-current={section === tab.id ? "page" : undefined}>
                {tab.label}
                {tab.id === "progress" && <DueCount client:idle lang={lang} />}
              </a>
            </li>
          ))}
        </ul>
        <ul class="nav-langs" aria-label={t("lang.label")}>
          {langs.map(([l, name]) => (
            <li>
              {l === lang ? (
                <span class="nav-lang" aria-current="true" lang={l}>
                  {name}
                </span>
              ) : (
                <a class="nav-lang" href={switchLang(path, l)} hreflang={l} lang={l} data-lang-choice={l}>
                  {name}
                </a>
              )}
            </li>
          ))}
        </ul>
        <a class="nav-repo" href={site.repository} rel="noopener">
          <Icon name="github" size={20} />
          <span class="visually-hidden">{t("footer.repository")}</span>
        </a>
        <button class="menu-button" type="button" aria-haspopup="dialog" aria-controls="site-menu" data-menu-open>
          {t("nav.menu")}
          <Icon name="menu" />
        </button>
      </nav>
    </header>

    <dialog class="menu" id="site-menu" aria-label={t("nav.label")}>
      <div class="menu-head">
        <a class="wordmark" href={homeUrl(lang)}>
          {siteTitle}
        </a>
        <button class="menu-button menu-close" type="button" data-menu-close>
          {t("nav.close")}
          <Icon name="close" />
        </button>
      </div>
      <ul class="menu-links">
        <li style="--i: 0">
          <a href={homeUrl(lang)} aria-current={path === homeUrl(lang) ? "page" : undefined}>
            {t("nav.home")}
          </a>
        </li>
        {tabs.map((tab, i) => (
          <li style={`--i: ${i + 1}`}>
            <a href={tab.href} aria-current={section === tab.id ? "page" : undefined}>
              {tab.label}
            </a>
          </li>
        ))}
      </ul>
      <ul class="menu-links menu-repo" style={`--i: ${tabs.length + 1}`}>
        <li>
          <a href={site.repository} rel="noopener">
            {t("footer.repository")}
          </a>
        </li>
      </ul>
      <ul class="menu-langs" aria-label={t("lang.label")} style={`--i: ${tabs.length + 2}`}>
        {langs.map(([l, name]) => (
          <li>
            {l === lang ? (
              <span aria-current="true" lang={l}>
                {name}
              </span>
            ) : (
              <a href={switchLang(path, l)} hreflang={l} lang={l} data-lang-choice={l}>
                {name}
              </a>
            )}
          </li>
        ))}
      </ul>
    </dialog>

    <main id="main" class="page">
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <p class="footer-title">{siteTitle}</p>
          <p class="footer-license">{t("footer.license")}</p>
        </div>
        <a class="pill footer-star" href={site.repository} rel="noopener">
          {t("footer.star")}
        </a>
        <ul class="footer-links" aria-label={t("footer.contact")}>
          {ownerLinks.map((link) => (
            <li>
              <a href={link.url} rel="noopener">
                {/* Zalo's mark is a wordmark inside the same square box, so it needs the larger size to read. */}
                <Icon name={link.kind} size={link.kind === "zalo" ? 24 : 20} />
                <span class="visually-hidden">{link.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </footer>

    <script>
      // Menu overlay: a modal <dialog> makes the page inert (focus stays inside) and closes on Esc.
      const menu = document.querySelector<HTMLDialogElement>("#site-menu");
      const opener = document.querySelector<HTMLButtonElement>("[data-menu-open]");
      opener?.addEventListener("click", () => menu?.showModal());
      document.querySelector("[data-menu-close]")?.addEventListener("click", () => menu?.close());
      menu?.addEventListener("close", () => opener?.focus());
      menu?.addEventListener("click", (event) => {
        if (event.target === menu) menu.close();
      });

      // Remember the language the learner reads in; `/` uses it (src/pages/index.astro).
      const remember = (lang: string) => {
        try {
          localStorage.setItem("atlas.lang", lang);
        } catch {
          // Storage unavailable: `/` falls back to English.
        }
      };
      remember(document.documentElement.lang);
      for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-lang-choice]")) {
        link.addEventListener("click", () => remember(link.dataset.langChoice ?? "en"));
      }
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: calc(-1 * var(--space-16));
    z-index: 30;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--sheet);
    color: var(--ink);
  }

  .skip-link:focus {
    top: var(--space-4);
  }

  .nav-wrap {
    position: sticky;
    top: var(--nav-offset);
    z-index: 20;
    padding: 0 var(--space-4);
    margin-top: var(--nav-offset);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    max-width: var(--nav-max);
    min-height: var(--nav-height);
    margin: 0 auto;
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-6);
    border: var(--border-width) solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--glass);
    backdrop-filter: var(--blur-glass);
    -webkit-backdrop-filter: var(--blur-glass);
    box-shadow: var(--shadow-float);
  }

  .wordmark {
    font-weight: 700;
    font-variation-settings: "wdth" var(--wdth-display);
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-tabs {
    flex: 1;
  }

  .nav-tab,
  .nav-lang {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 2.5rem;
    padding: 0 var(--space-3);
    border-radius: var(--radius-pill);
    color: var(--ink-muted);
    text-decoration: none;
    transition: color var(--duration-control) var(--ease);
  }

  .nav-tab:hover,
  .nav-lang:is(a):hover {
    color: var(--ink);
  }

  .nav-tab[aria-current="page"] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--route);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.5em;
  }

  .nav-lang[aria-current] {
    color: var(--ink);
    font-weight: 600;
  }

  .menu-button {
    display: none;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.5rem;
    margin-left: auto;
    padding: 0 var(--space-4);
    border: var(--border-width) solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--sheet);
    color: var(--ink);
    font: inherit;
    cursor: pointer;
  }

  @media (width < 768px) {
    .nav-wrap {
      padding: 0 var(--space-2);
    }

    .nav {
      padding-left: var(--space-5);
    }

    .nav-tabs,
    .nav-langs {
      display: none !important;
    }

    .menu-button {
      display: inline-flex;
    }
  }

  .menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: var(--space-4) var(--space-6);
    border: 0;
    background: var(--ground);
    color: var(--ink);
  }

  .menu[open] {
    animation: menu-in var(--duration-sheet) var(--ease);
  }

  @keyframes menu-in {
    from {
      opacity: 0;
    }
  }

  .menu::backdrop {
    background: var(--scrim);
  }

  .menu-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--nav-height);
  }

  .menu-close {
    display: inline-flex;
  }

  .menu-links {
    margin: var(--space-12) 0 var(--space-8);
    padding: 0;
    list-style: none;
  }

  .menu-links li,
  .menu-langs {
    opacity: 0;
    transform: translateY(var(--space-8));
    transition:
      opacity var(--duration-sheet) var(--ease),
      transform var(--duration-sheet) var(--ease);
    transition-delay: calc(var(--i) * 60ms);
  }

  .menu[open] .menu-links li,
  .menu[open] .menu-langs {
    opacity: 1;
    transform: none;
  }

  @starting-style {
    .menu[open] .menu-links li,
    .menu[open] .menu-langs {
      opacity: 0;
      transform: translateY(var(--space-8));
    }
  }

  .menu-links a {
    display: block;
    padding: var(--space-2) 0;
    font-size: var(--text-display-s);
    font-weight: 700;
    font-variation-settings: "wdth" var(--wdth-display);
    line-height: var(--leading-display);
    color: var(--ink);
    text-decoration: none;
  }

  .menu-links a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--route);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.2em;
  }

  .menu-langs {
    display: flex;
    gap: var(--space-6);
    margin: 0;
    padding: var(--space-6) 0 0;
    border-top: var(--border-width) solid var(--line);
    list-style: none;
  }

  .menu-langs a,
  .menu-langs span {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  .menu-langs [aria-current] {
    font-weight: 600;
  }

  .page {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-12) var(--gutter) var(--space-24);
  }

  @media (width < 768px) {
    .page {
      padding: var(--space-8) var(--space-4) var(--space-16);
    }
  }

  .footer {
    border-top: var(--border-width) solid var(--line);
    color: var(--ink-muted);
    font-size: var(--text-small);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-8) var(--gutter) var(--space-12);
  }

  .footer-title {
    margin: 0;
    font-weight: 600;
    color: var(--ink);
  }

  .footer-license {
    margin: 0;
  }

  .footer ul {
    display: flex;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Star first, then the owner's links: one row that wraps to its own line on a phone. */
  .footer-star {
    font-size: var(--text-small);
    padding-block: var(--space-2);
  }

  .footer-links {
    gap: var(--space-3);
    margin-inline-start: auto;
  }

  .footer-links a,
  .nav-repo {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-pill);
    color: var(--ink-muted);
    transition:
      color var(--duration-control) var(--ease),
      background-color var(--duration-control) var(--ease);
  }

  .footer-links a:hover,
  .nav-repo:hover {
    color: var(--ink);
    background: var(--tray);
  }

  /* The pill nav has no room for the repository icon on a phone; the menu overlay carries it. */
  @media (width < 640px) {
    .nav-repo {
      display: none;
    }
  }

  @media (width < 640px) {
    .footer-inner {
      justify-content: flex-start;
    }

    .footer-links {
      margin-inline-start: 0;
    }
  }
</style>
