---
// Global frame (DESIGN.md → Global frame): a plain top bar with a hairline under it, and the footer.
import { Font } from "astro:assets";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/islands.css";
import Icon from "../components/Icon.astro";
import DueCount from "../components/react/DueCount";
import { languages, useTranslations, type Lang } from "../i18n";
import { changes, site, text } from "../lib/atlas";
import AccountMenu from "../components/react/AccountMenu";
import { changesUrl, homeUrl, howUrl, mapUrl, privacyUrl, progressUrl, searchUrl, switchLang } from "../lib/urls";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Section of the site this page belongs to, for the active tab. */
  section?: "atlas" | "progress" | "search";
}

const { lang, title, description, section } = Astro.props;
const t = useTranslations(lang);
const siteTitle = text(site.title, lang).value;
const pageTitle = title ? `${title} | ${siteTitle}` : siteTitle;
const path = Astro.url.pathname;
const tabs = [
  { id: "atlas", href: mapUrl(lang), label: t("nav.atlas") },
  { id: "progress", href: progressUrl(lang), label: t("nav.progress") },
  { id: "search", href: searchUrl(lang), label: t("nav.search") },
] as const;
const langs = Object.entries(languages) as [Lang, string][];
// Owner links are content (site.links), so adding one is a presentation.yaml change.
const linkLabels = {
  github: "GitHub",
  email: "Email",
  whatsapp: "WhatsApp",
  zalo: "Zalo",
  x: "X",
  linkedin: "LinkedIn",
} as const;
const ownerLinks = (site.links ?? []).map((l) => ({ ...l, label: linkLabels[l.kind] }));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? text(site.tagline, lang).value} />
    {langs.map(([l]) => (
      <link rel="alternate" hreflang={l} href={new URL(switchLang(path, l), Astro.site)} />
    ))}
    <Font cssVariable="--font-sans" preload={[{ subset: "latin" }]} />
    <Font cssVariable="--font-reading" />
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t("nav.skip")}
    </a>
    <header class="topbar">
      <nav class="topbar-inner" aria-label={t("nav.label")}>
        <a class="wordmark" href={homeUrl(lang)}>
          {siteTitle}
        </a>
        <ul class="topbar-tabs">
          {tabs.map((tab) => (
            <li>
              <a class="topbar-tab" href={tab.href} aria-current={section === tab.id ? "page" : undefined}>
                {tab.label}
                {tab.id === "progress" && <DueCount client:idle lang={lang} />}
              </a>
            </li>
          ))}
        </ul>
        <ul class="topbar-langs" aria-label={t("lang.label")}>
          {langs.map(([l, name]) => (
            <li>
              {l === lang ? (
                <span class="topbar-lang" aria-current="true" lang={l}>
                  {name}
                </span>
              ) : (
                <a class="topbar-lang" href={switchLang(path, l)} hreflang={l} lang={l} data-lang-choice={l}>
                  {name}
                </a>
              )}
            </li>
          ))}
        </ul>
        {/* Renders nothing until /api/me answers, and nothing at all without the Worker's API. */}
        <AccountMenu client:idle lang={lang} />
        <a class="topbar-repo" href={site.repository} rel="noopener">
          <Icon name="github" size={20} />
          <span class="visually-hidden">{t("footer.repository")}</span>
        </a>
      </nav>
    </header>

    <main id="main" class="page">
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <p class="footer-brand">
          <strong>{siteTitle}</strong>
          <span>{t("footer.license")}</span>
          <a href={howUrl(lang)}>{t("how.title")}</a>
          {changes && <a href={changesUrl(lang)}>{t("changes.title")}</a>}
          <a href={privacyUrl(lang)}>{t("footer.privacy")}</a>
          <a href={site.repository} rel="noopener">
            {t("footer.star")}
          </a>
        </p>
        <ul class="footer-links" aria-label={t("footer.contact")}>
          {ownerLinks.map((link) => (
            <li>
              <a href={link.url} rel="noopener">
                {/* Zalo's mark is a wordmark inside the same square box, so it needs the larger size to read. */}
                <Icon name={link.kind} size={link.kind === "zalo" ? 24 : 20} />
                <span class="visually-hidden">{link.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </footer>

    <script>
      // Remember the language the learner reads in; `/` uses it (src/pages/index.astro).
      const remember = (lang: string) => {
        try {
          localStorage.setItem("atlas.lang", lang);
        } catch {
          // Storage unavailable: `/` falls back to English.
        }
      };
      remember(document.documentElement.lang);
      for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-lang-choice]")) {
        link.addEventListener("click", () => remember(link.dataset.langChoice ?? "en"));
      }
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: calc(-1 * var(--space-16));
    z-index: 30;
    padding: var(--space-2) var(--space-4);
    border: var(--border-width) solid var(--ink);
    border-radius: var(--radius-control);
    background: var(--sheet);
    color: var(--ink);
  }

  .skip-link:focus {
    top: var(--space-2);
  }

  /* The top bar: full width, an ink hairline under it, never blurred. It sticks on wider
     screens (scroll-padding in base.css keeps focused content below it) and scrolls away on a
     phone, where the route's step bar and field-log bar need the room. */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: var(--border-width) solid var(--ink);
    background: var(--ground);
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    max-width: var(--page-max);
    min-height: var(--nav-height);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .wordmark {
    font-family: var(--font-reading);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .topbar ul {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .topbar-tabs {
    flex: 1;
  }

  .topbar-tab,
  .topbar-lang {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--nav-height);
    color: var(--ink);
    text-decoration: none;
  }

  .topbar-tab:hover,
  .topbar-lang:is(a):hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  /* The current section: a magenta rule standing on the bar's hairline. */
  .topbar-tab[aria-current="page"] {
    padding-top: 3px;
    border-bottom: 3px solid var(--route);
  }

  .topbar-tab[aria-current="page"]:hover {
    text-decoration: none;
  }

  .topbar-langs {
    font-size: var(--text-small);
  }

  .topbar-lang:is(a) {
    color: var(--ink-muted);
  }

  .topbar-lang[aria-current] {
    font-weight: 600;
  }

  .topbar-repo {
    display: inline-grid;
    place-items: center;
    min-width: 2.25rem;
    min-height: 2.25rem;
    padding-inline-start: var(--space-4);
    border-left: var(--border-width) solid var(--line);
    color: var(--ink-muted);
  }

  .topbar-repo:hover {
    color: var(--ink);
  }

  @media (width < 768px) {
    .topbar {
      position: static;
    }

    .topbar-inner {
      flex-wrap: wrap;
      gap: 0 var(--space-5);
      padding-top: var(--space-2);
    }

    .wordmark {
      flex: 1 0 auto;
      font-size: 1.125rem;
    }

    /* Two rows: wordmark and sign-in; a zero-height break; then the tabs and languages. */
    .topbar-inner::after {
      content: "";
      flex-basis: 100%;
      order: 2;
    }

    .topbar-tabs,
    .topbar-langs {
      order: 3;
    }

    .topbar-inner :global(.account-trigger),
    .topbar-inner :global(.account-error) {
      order: 1;
    }

    .topbar-tab,
    .topbar-lang {
      min-height: 2.5rem;
    }

    .topbar-repo {
      display: none;
    }
  }

  .page {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-12) var(--gutter) var(--space-24);
  }

  @media (width < 768px) {
    .page {
      padding: var(--space-8) var(--gutter) var(--space-16);
    }
  }

  .footer {
    border-top: var(--border-width) solid var(--ink);
    color: var(--ink-muted);
    font-size: var(--text-small);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-8);
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-6) var(--gutter) var(--space-12);
  }

  .footer-brand {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-5);
    margin: 0;
  }

  .footer-brand strong {
    font-weight: 600;
    color: var(--ink);
  }

  .footer-brand a {
    color: var(--ink);
  }

  .footer-links {
    display: flex;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-links a {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--ink-muted);
    transition: color var(--duration-control) var(--ease);
  }

  .footer-links a:hover {
    color: var(--ink);
  }

  @media (width < 640px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer-links {
      margin-inline-start: calc(-1 * var(--space-2));
    }
  }
</style>
