---
// Library (DESIGN.md → Library): the sources the atlas routes through, as a bibliography in
// sections, each linking to the public resource and to the routes that cite it. We do not rewrite
// these sources; we say what to open and why, so this page is the index of that promise.
import Breadcrumb from "../../../components/Breadcrumb.astro";
import Base from "../../../layouts/Base.astro";
import LibraryList from "../../../components/react/LibraryList";
import { langPaths, type Lang, useTranslations } from "../../../i18n";
import { library } from "../../../lib/summaries";
import { mapUrl } from "../../../lib/urls";

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
// One section per resource type the sources carry, named by the content model (resource_type) in
// sentence case; untyped sources, if any, close the list under "Other".
const sections = library(lang).map((section) => {
  const label = section.label ?? { value: t("library.otherKind"), lang };
  return {
    ...section,
    label: { ...label, value: label.value.charAt(0).toLocaleUpperCase(label.lang) + label.value.slice(1) },
  };
});
---

<Base lang={lang} title={t("library.title")} description={t("library.intro")}>
  <Breadcrumb lang={lang} crumbs={[{ label: t("nav.atlas"), href: mapUrl(lang) }, { label: t("library.title") }]} />
  <h1 class="page-title">{t("library.title")}</h1>
  <p class="lead">{t("library.intro")}</p>

  <LibraryList client:load lang={lang} sections={sections} />
</Base>
