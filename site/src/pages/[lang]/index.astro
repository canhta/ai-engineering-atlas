---
// Home (DESIGN.md → Home): title, promise, start action, the plate in overview mode, then the
// specimen of one ready route. Once the learner has evidence, their next steps lead beside the title.
import Base from "../../layouts/Base.astro";
import Plate from "../../components/plate/Plate";
import PlateLegend from "../../components/plate/PlateLegend";
import Specimen from "../../components/Specimen.astro";
import NextSteps from "../../components/react/NextSteps";
import { langPaths, useTranslations, type Lang } from "../../i18n";
import { langAttr, site, stateLabels, text } from "../../lib/atlas";
import { specimen } from "../../lib/specimen";
import { nextGraph, nextLinks, plateRegions } from "../../lib/summaries";
import { mapUrl } from "../../lib/urls";

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const title = text(site.title, lang);
const tagline = text(site.tagline, lang);
const regions = plateRegions(lang);
const tiles = regions.flatMap((r) => r.tiles);
const ready = tiles.filter((tile) => tile.href).length;
const route = specimen(lang);
---

<Base lang={lang}>
  <div class="hero-row">
    <section class="hero" aria-labelledby="home-title">
      <h1 id="home-title" class="home-title" lang={langAttr(title, lang)}>
        {title.value}
      </h1>
      <p class="home-subtitle" lang={langAttr(tagline, lang)}>
        {tagline.value}
      </p>
      <p class="muted">{t("home.method")}</p>
      <div class="hero-actions">
        <a class="button button-primary" href={`${mapUrl(lang)}?ready=1`}>
          {t("home.start")}
        </a>
        {route && <a href="#specimen">{t("home.jump")}</a>}
      </div>
    </section>
    <NextSteps client:load lang={lang} graph={nextGraph()} links={nextLinks(lang)} limit={3} onlyWithEvidence />
  </div>

  <section class="home-plate" aria-labelledby="plate-title">
    <div class="plate-head">
      <h2 id="plate-title" class="visually-hidden">
        {t("home.plate")}
      </h2>
      <p class="muted tabular">{t("home.counts", { ready, mapped: tiles.length - ready })}</p>
      <PlateLegend lang={lang} stateLabels={stateLabels(lang)} />
    </div>
    <Plate
      client:load
      lang={lang}
      mode="overview"
      regions={regions}
      stateLabels={stateLabels(lang)}
      atlasUrl={mapUrl(lang)}
      regionHeading="h3"
    />
  </section>

  {route && <Specimen lang={lang} specimen={route} />}
</Base>

<style>
  /* Hero, and the learner's next steps beside it once they have evidence (DESIGN.md → Next step). */
  .hero-row {
    display: grid;
    grid-template-columns: minmax(0, 56rem) minmax(0, 22rem);
    justify-content: space-between;
    align-items: end;
    gap: var(--space-8) var(--space-12);
    margin-bottom: var(--space-12);
  }

  .hero {
    max-width: 56rem;
  }

  @media (width < 1024px) {
    .hero-row {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* The one large title on the site (DESIGN.md → Type). */
  .home-title {
    margin: 0 0 var(--space-5);
    font-size: var(--text-home);
    line-height: 1;
    letter-spacing: -0.025em;
  }

  .home-subtitle {
    max-width: 34ch;
    margin-bottom: var(--space-3);
    font-family: var(--font-reading);
    font-size: var(--text-standfirst);
    line-height: 1.35;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-6);
  }

  .home-plate {
    margin-bottom: var(--space-12);
  }

  .plate-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    margin-bottom: var(--space-4);
  }

  .plate-head p {
    margin: 0;
  }
</style>
