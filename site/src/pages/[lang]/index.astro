---
import Base from "../../layouts/Base.astro";
import StatusLabel from "../../components/StatusLabel.astro";
import { langPaths, useTranslations, type Lang } from "../../i18n";
import { competencies, domains, labs, readyCompetencies, routes } from "../../lib/atlas";
import { mapUrl, routeUrl } from "../../lib/urls";

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const readyByDomain = domains
  .map((d) => ({ ...d, items: readyCompetencies.filter((c) => c.domain === d.id) }))
  .filter((d) => d.items.length > 0);
const englishText = lang === "en" ? undefined : "en";
---

<Base lang={lang}>
  <h1>{t("site.name")}</h1>
  <p class="reading">{t("site.tagline")}</p>
  <p class="reading">{t("site.method")}</p>
  <p class="counts">
    {
      t("home.counts", {
        ready: readyCompetencies.length,
        mapped: competencies.length - readyCompetencies.length,
        labs: labs.length,
      })
    }
  </p>
  <p>{t("home.diagnostic")}</p>
  <p><a href={mapUrl(lang)}>{t("home.start")}</a></p>

  <h2>{t("home.ready.title")}</h2>
  <p class="muted">{t("home.ready.intro")}</p>
  {
    readyByDomain.map((d) => (
      <section>
        <h3 lang={englishText}>{d.title}</h3>
        <ul class="route-list">
          {d.items.map((c) => (
            <li>
              <a href={routeUrl(lang, c.id)} lang={englishText}>
                {c.title}
              </a>
              <span class="meta">
                <code>{c.id}</code> · {routes[c.id]?.target_level} · <StatusLabel status="ready" lang={lang} />
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
  <p class="muted">{t("home.coverage.note")}</p>
</Base>

<style>
  .counts {
    font-weight: 500;
  }

  .route-list {
    list-style: none;
    padding: 0;
    border-top: var(--border-width) solid var(--border);
  }

  .route-list li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-2) 0;
    border-bottom: var(--border-width) solid var(--border);
  }

  .meta {
    color: var(--text-muted);
    font-size: var(--text-small);
  }
</style>
