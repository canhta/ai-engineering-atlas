---
// Home (DESIGN.md → Home): headline, the plate in overview mode, how the atlas works, and the
// ready routes by group.
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Plate from "../../components/plate/Plate";
import PlateLegend from "../../components/plate/PlateLegend";
import ReadyRows, { type ReadyGroup } from "../../components/react/ReadyRows";
import { langPaths, useTranslations, type Lang } from "../../i18n";
import { langAttr, site, stateLabels, text } from "../../lib/atlas";
import NextSteps from "../../components/react/NextSteps";
import { itemDetails, nextGraph, nextLinks, plateRegions } from "../../lib/summaries";
import { mapUrl } from "../../lib/urls";

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const title = text(site.title, lang);
const tagline = text(site.tagline, lang);
const regions = plateRegions(lang);
const details = itemDetails(lang);
const tiles = regions.flatMap((r) => r.tiles);
const ready = tiles.filter((tile) => tile.href).length;
const readyGroups: ReadyGroup[] = regions
  .map((r) => ({
    value: r.value,
    label: r.label,
    rows: r.tiles
      .filter((tile) => tile.href)
      .map((tile) => ({
        ref: tile.ref,
        title: tile.title,
        href: tile.href!,
        chips: details[tile.ref].chips.filter((chip) => chip.code).map((chip) => `${chip.code} ${chip.label.value}`),
        sources: details[tile.ref].sources,
      })),
  }))
  .filter((g) => g.rows.length > 0);
const steps = ["diagnose", "read", "practice", "record"] as const;
---

<Base lang={lang}>
  <div class="hero-row">
    <section class="hero" aria-labelledby="home-title">
      <h1 id="home-title" class="display home-title" lang={langAttr(title, lang)}>{title.value}</h1>
      <p class="subtitle home-subtitle" lang={langAttr(tagline, lang)}>{tagline.value}</p>
      <p class="muted">{t("home.method")}</p>
      <div class="hero-actions">
        <a class="pill pill-primary" href={`${mapUrl(lang)}?ready=1`}>
          {t("home.start")}
          <span class="pill-icon"><Icon name="forward" /></span>
        </a>
        <a class="button-quiet" href="#how">{t("home.how")}</a>
      </div>
    </section>
    <NextSteps client:load lang={lang} graph={nextGraph()} links={nextLinks(lang)} limit={3} onlyWithEvidence />
  </div>

  <section class="home-plate" aria-labelledby="plate-title">
    <div class="plate-head">
      <h2 id="plate-title" class="visually-hidden">{t("home.plate")}</h2>
      <p class="muted tabular">{t("home.counts", { ready, mapped: tiles.length - ready })}</p>
      <PlateLegend lang={lang} stateLabels={stateLabels(lang)} />
    </div>
    <Plate client:load lang={lang} mode="overview" regions={regions} stateLabels={stateLabels(lang)} atlasUrl={mapUrl(lang)} regionHeading="h3" reveal />
  </section>

  <section id="how" class="how" aria-labelledby="how-title">
    <h2 id="how-title">{t("home.how")}</h2>
    <ol>
      {
        steps.map((step, i) => (
          <li>
            <span class="how-num tabular" aria-hidden="true">
              {i + 1}
            </span>
            <strong>{t(`home.step.${step}.title`)}</strong>
            <span class="muted">{t(`home.step.${step}.body`)}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="home-ready" aria-labelledby="ready-title">
    <h2 id="ready-title">{t("home.ready.title")}</h2>
    <ReadyRows client:idle lang={lang} groups={readyGroups} stateLabels={stateLabels(lang)} />
  </section>
</Base>

<style>
  /* Hero, and the learner's next steps beside it once they have evidence (DESIGN.md → Next step). */
  .hero-row {
    display: grid;
    grid-template-columns: minmax(0, 56rem) minmax(0, 22rem);
    justify-content: space-between;
    align-items: end;
    gap: var(--space-8) var(--space-12);
    margin-bottom: var(--space-12);
  }

  .hero {
    max-width: 56rem;
  }

  @media (width < 1024px) {
    .hero-row {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .home-title {
    font-size: clamp(2.75rem, 1.6rem + 4.2vw, 4.5rem);
  }

  .home-subtitle {
    max-width: 30ch;
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.625rem);
    line-height: 1.3;
    margin-bottom: var(--space-3);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-6);
  }

  .home-plate {
    margin-bottom: var(--space-16);
  }

  .plate-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    margin-bottom: var(--space-4);
  }

  .plate-head p {
    margin: 0;
  }

  .how {
    margin-bottom: var(--space-16);
  }

  .how ol {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .how li {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding-top: var(--space-4);
    border-top: var(--border-width) solid var(--line);
  }

  .how-num {
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--route);
  }

  @media (width < 1024px) {
    .how ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width < 768px) {
    .how ol {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }
  }
</style>
