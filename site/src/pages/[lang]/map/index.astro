---
// Atlas (DESIGN.md → Atlas): plate and list over the tracked collection, filters, and the drawer.
import Base from "../../../layouts/Base.astro";
import AtlasExplorer from "../../../components/react/AtlasExplorer";
import { langPaths, useTranslations, type Lang } from "../../../i18n";
import { collections, pageSegment, site, stateLabels, text, trackedCollection as c } from "../../../lib/atlas";
import { facets, itemDetails, listColumns, plateRegions, relatedFacets } from "../../../lib/summaries";
import { mapUrl } from "../../../lib/urls";

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const regions = plateRegions(lang);
const total = regions.reduce((n, r) => n + r.tiles.length, 0);
// The other collections have index pages of their own (labs, projects, paths).
const others = [
  ...collections
    .filter((other) => other.id !== c.id)
    .map((other) => ({ href: `/${lang}/${pageSegment(other)}/`, label: text(other.label, lang) })),
  { href: `/${lang}/sources/`, label: { value: t("library.title"), lang } },
];
---

<Base lang={lang} title={t("map.title")} section="atlas">
  <AtlasExplorer
    client:load
    lang={lang}
    title={t("map.title")}
    intro={t("map.intro", { count: total, groups: regions.length })}
    atlasUrl={mapUrl(lang)}
    contributeUrl={`${site.repository}/blob/main/CONTRIBUTING.md`}
    regions={regions}
    details={itemDetails(lang)}
    facets={facets(lang)}
    relatedFacets={relatedFacets(lang)}
    itemLabel={text(c.label, lang).value}
    listColumns={listColumns(lang)}
    stateLabels={stateLabels(lang)}
  />

  <nav class="collection-links" aria-label={t("collection.also")}>
    <span class="muted small">{t("collection.also")}</span>
    {others.map((other) => (
      <a href={other.href} lang={other.label.lang === lang ? undefined : other.label.lang}>
        {other.label.value}
      </a>
    ))}
  </nav>
</Base>

<style>
  .collection-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-4);
    margin: var(--space-12) 0 var(--space-8);
    padding-top: var(--space-5);
    border-top: var(--border-width) solid var(--line);
  }
</style>
