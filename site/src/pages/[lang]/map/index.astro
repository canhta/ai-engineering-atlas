---
import Base from "../../../layouts/Base.astro";
import MapExplorer, { type MapGroup } from "../../../components/react/MapExplorer";
import { langPaths, useTranslations, type Lang } from "../../../i18n";
import { competencies, competency, domains, projects, routes } from "../../../lib/atlas";

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const groups: MapGroup[] = domains.map((d) => ({
  id: d.id,
  title: d.title,
  items: competencies
    .filter((c) => c.domain === d.id)
    .map((c) => ({
      id: c.id,
      title: c.title,
      ready: Boolean(routes[c.id]),
      level: routes[c.id]?.target_level ?? "",
      prerequisites: (routes[c.id]?.prerequisites ?? []).map((p) => ({
        id: p,
        title: competency(p)?.title ?? p,
        ready: Boolean(routes[p]),
      })),
    })),
}));
const projectFilters = projects.map((p) => ({ id: p.id, title: p.title, competencies: p.competencies }));
---

<Base lang={lang} title={t("map.title")}>
  <h1>{t("map.title")}</h1>
  <p class="reading">{t("map.intro")}</p>
  <MapExplorer client:load lang={lang} groups={groups} projects={projectFilters} />
</Base>
