---
import Base from "../../../layouts/Base.astro";
import MapExplorer, { type MapFilter, type MapGroup } from "../../../components/react/MapExplorer";
import { langPaths, useTranslations, type Lang } from "../../../i18n";
import {
  collections,
  fieldChips,
  groupsOf,
  itemUrl,
  itemsOf,
  refOf,
  relations,
  relationsTo,
  resolveRef,
  stateLabels,
  text,
  trackedCollection as c,
  trackedItems,
  vocabularyLabel,
} from "../../../lib/atlas";

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const columns = c.list_fields ?? [];
const titleOf = (ref: string) => {
  const found = resolveRef(ref);
  return found ? text(found.item.title, lang) : { value: ref, lang: "en" as const };
};
const groups: MapGroup[] = groupsOf(c).map((g) => ({
  id: g.value,
  title: vocabularyLabel(g.vocabulary, g.value, lang),
  items: g.items.map((item) => {
    const ref = refOf(c, item);
    return {
      id: ref,
      title: text(item.title, lang),
      href: itemUrl(lang, ref),
      facts: columns.map((f) =>
        fieldChips(c, item, f, lang)
          .map((chip) => chip.label.value)
          .join(", "),
      ),
      prerequisites: relationsTo("prerequisite", ref).map((r) => ({ id: r.from, title: titleOf(r.from), href: itemUrl(lang, r.from) })),
    };
  }),
}));

// Other collections whose items point at tracked items (projects) become filters.
const trackedRefs = new Set(trackedItems.map((i) => refOf(c, i)));
const filters: MapFilter[] = collections
  .filter((other) => other !== c)
  .map((other) => ({
    label: text(other.label, lang).value,
    options: itemsOf(other.id)
      .map((item) => {
        const ref = refOf(other, item);
        return {
          id: ref,
          title: text(item.title, lang),
          members: relations.filter((r) => r.from === ref && trackedRefs.has(r.to)).map((r) => r.to),
        };
      })
      .filter((o) => o.members.length > 0),
  }))
  .filter((f) => f.options.length > 0);
---

<Base lang={lang} title={t("map.title")} section="atlas">
  <h1 class="display">{t("map.title")}</h1>
  <p class="subtitle">{t("map.intro")}</p>
  <MapExplorer
    client:load
    lang={lang}
    itemLabel={text(c.label, lang).value}
    columns={columns.map((f) => text(c.fields[f]?.label, lang).value)}
    groups={groups}
    filters={filters}
    stateLabels={stateLabels(lang)}
  />
</Base>
