---
// Index of a collection that is not the tracked one (labs, projects, paths today), set as a
// printed catalogue (DESIGN.md → Collection indexes): one ruled row per item with what it asks, how
// it runs, and the routes it is practice for or brings together, each with the learner's state
// glyph after hydration. Generic: columns appear only when some item has the data, so a new
// collection gets a page with no new code. The catalogue's styles live in islands.css (Catalogue),
// shared with the Atlas index.
import Breadcrumb from "../../../components/Breadcrumb.astro";
import PrereqLine, { type PrereqEntry, type PrereqGroup } from "../../../components/react/PrereqLine";
import Base from "../../../layouts/Base.astro";
import { languages, type Lang, useTranslations } from "../../../i18n";
import {
  benchOf,
  collections,
  groupOf,
  groupsOf,
  itemsOf,
  itemUrl,
  langAttr,
  pageSegment,
  passageOf,
  stateLabels,
  text,
  trackedCollection,
  trackedItemsFrom,
  trackedItemsPointingAt,
  type Item,
} from "../../../lib/atlas";
import { refOf } from "../../../lib/refs";
import { mapUrl } from "../../../lib/urls";

export function getStaticPaths() {
  const langs = Object.keys(languages) as Lang[];
  return collections
    .filter((c) => c.id !== trackedCollection.id)
    .flatMap((c) => langs.map((lang) => ({ params: { lang, collection: pageSegment(c) }, props: { collection: c } })));
}

const { collection } = Astro.props;
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const label = text(collection.label, lang);
const items = itemsOf(collection.id);

// The routes an item relates to: the tracked items pointing at it (what a lab is practice for) or,
// when none in this collection do, the ones it points at (the routes a project brings together).
const inward = items.some((item) => trackedItemsPointingAt(refOf(collection, item)).length > 0);
const relatedLead = t(inward ? "collection.practisesFor" : "collection.covers");
const relatedOf = (ref: string): Item[] => (inward ? trackedItemsPointingAt(ref) : trackedItemsFrom(ref));
const entryOf = (tracked: Item): PrereqEntry => {
  const trackedRef = refOf(trackedCollection, tracked);
  return { ref: trackedRef, title: text(tracked.title, lang), url: itemUrl(lang, trackedRef) };
};

// Beyond six routes a row groups them by region, in the vocabulary's order, so a project that
// brings together dozens reads as a short run per region instead of one long line.
const GROUP_BEYOND = 6;
const regionOrder = groupsOf(trackedCollection).map((g) => g.value);
const rank = (region: string) => (regionOrder.includes(region) ? regionOrder.indexOf(region) : regionOrder.length);
const groupedOf = (related: Item[]): PrereqGroup[] | undefined => {
  if (related.length <= GROUP_BEYOND) return undefined;
  const regions = new Map<string, PrereqGroup>();
  for (const tracked of related) {
    const region = groupOf(trackedCollection, tracked, lang);
    const key = region?.value ?? "";
    const group = regions.get(key) ?? { label: region?.label ?? { value: "", lang }, entries: [] };
    group.entries.push(entryOf(tracked));
    regions.set(key, group);
  }
  return [...regions.entries()].sort(([a], [b]) => rank(a) - rank(b)).map(([, group]) => group);
};
const labels = stateLabels(lang);

const benchLabel = {
  runner: t("collection.runs.runner"),
  form: t("collection.runs.form"),
  none: t("collection.runs.none"),
};

const rows = items.map((item) => {
  const ref = refOf(collection, item);
  const related = relatedOf(ref);
  return {
    ref,
    title: text(item.title, lang),
    url: itemUrl(lang, ref),
    asks: passageOf(item, lang),
    bench: item.page ? benchLabel[benchOf(item) ?? "none"] : undefined,
    related: related.map(entryOf),
    groups: groupedOf(related),
  };
});
const withPage = rows.filter((row) => row.url).length;
// Text without a reviewed translation renders in English with its own `lang`, under the marker.
const untranslated = rows.some((row) => row.title.lang !== lang || (row.asks && row.asks.lang !== lang));

// A column shows when some item has something to put in it; "how it runs" only when some item runs
// in the browser, so a collection without a bench never reads "README only" on every row.
const columns = {
  asks: rows.some((row) => row.asks),
  bench: items.some((item) => benchOf(item)),
  related: rows.some((row) => row.related.length > 0),
};
// With titles alone there is nothing to head; the ink rule then sits above the first row.
const headed = Object.values(columns).some(Boolean);
---

<Base lang={lang} title={label.value} description={t("collection.intro", { label: label.value })}>
  <Breadcrumb lang={lang} crumbs={[{ label: t("nav.atlas"), href: mapUrl(lang) }, { label: label.value }]} />
  <h1 class="page-title" lang={langAttr(label, lang)}>
    {label.value}
  </h1>
  <p class="lead">
    {withPage === rows.length
      ? t("collection.all", { total: rows.length })
      : t("collection.count", { shown: withPage, total: rows.length })}
  </p>
  {untranslated && (
    <p class="untranslated small" role="note">
      {t("translation.missing")}
    </p>
  )}

  <table
    class:list={["catalogue", { headed, "has-bench": columns.bench, "has-related": columns.related }]}
    role="table"
    aria-label={label.value}
  >
    <thead role="rowgroup" class:list={{ "visually-hidden": !headed }}>
      <tr role="row">
        <th scope="col" role="columnheader">
          {t("collection.col.title")}
        </th>
        {columns.asks && (
          <th scope="col" role="columnheader">
            {t("collection.col.asks")}
          </th>
        )}
        {columns.bench && (
          <th scope="col" role="columnheader">
            {t("collection.col.runs")}
          </th>
        )}
        {columns.related && (
          <th scope="col" role="columnheader">
            {relatedLead}
          </th>
        )}
      </tr>
    </thead>
    <tbody role="rowgroup">
      {rows.map((row) => (
        <tr role="row" data-ref={row.ref}>
          <th scope="row" role="rowheader" class="catalogue-title">
            {row.url ? (
              <a href={row.url} lang={langAttr(row.title, lang)}>
                {row.title.value}
              </a>
            ) : (
              <span lang={langAttr(row.title, lang)}>{row.title.value}</span>
            )}
          </th>
          {columns.asks && (
            <td role="cell" class="catalogue-asks">
              {row.asks && <span lang={langAttr(row.asks, lang)}>{row.asks.value}</span>}
            </td>
          )}
          {columns.bench && (
            <td role="cell" class="catalogue-bench">
              {row.bench && (
                <>
                  <span class="cell-label">{t("collection.col.runs")}: </span>
                  {row.bench}
                </>
              )}
            </td>
          )}
          {columns.related && (
            <td role="cell" class="catalogue-related">
              {row.related.length > 0 && (
                <PrereqLine
                  client:idle
                  lang={lang}
                  stateLabels={labels}
                  entries={row.related}
                  groups={row.groups}
                  lead={relatedLead}
                />
              )}
            </td>
          )}
        </tr>
      ))}
    </tbody>
  </table>
</Base>
